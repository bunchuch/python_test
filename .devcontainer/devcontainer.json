{
  "name": "Sabre Mapper (MSSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-mssql.mssql"
      ]
    }
  },

  // Create SabreDB, then bootstrap schema + seed admin user
  "postCreateCommand": "python .devcontainer/create-db.py && python -c \"from data.db import ensure_schema; ensure_schema()\"",

  "postAttachCommand": {
    "streamlit": "streamlit run main.py --server.enableCORS false --server.enableXsrfProtection false"
  },

  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openPreview"
    },
    "1433": {
      "label": "SQL Server",
      "onAutoForward": "ignore"
    }
  },
  "forwardPorts": [8501, 1433]
}
